{
  "manifest_version": 3,
  "name": "Read Aloud (local Kokoro)",
  "version": "0.1.0",
  "description": "Reads articles and selections aloud with a local Kokoro voice, highlighting each word. Nothing leaves your machine.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Read aloud (Alt+Shift+R)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Read the selection or article; pause or resume"
    }
  }
}
